    {
      "type": "frame",
      "id": "Zp9O4",
      "x": 0,
      "y": 600,
      "name": "Token Reference",
      "width": 760,
      "fill": "$color/surface",
      "stroke": {
        "align": "inside",
        "thickness": 1,
        "fill": "$color/border"
      },
      "layout": "vertical",
      "gap": 24,
      "padding": 48,
      "children": [
        {
          "type": "text",
          "id": "3q3fb",
          "name": "refTitle",
          "fill": "$color/text",
          "content": "Token Reference",
          "fontFamily": "$font/display",
          "fontSize": "$text/h2",
          "fontWeight": "$font-weight/display"
        },
        {
          "type": "text",
          "id": "idLrJ",
          "name": "refSub",
          "fill": "$color/text-muted",
          "textGrowth": "fixed-width",
          "width": 664,
          "content": "Pencil variable → CSS custom property (33 tokens). Single source of truth bridging design/design-system.pen and src/styles/v2/global.css.",
          "lineHeight": "$leading/text",
          "fontFamily": "$font/text",
          "fontSize": "$text/small",
          "fontWeight": "$font-weight/text"
        },
        {
          "type": "text",
          "id": "UVenn",
          "name": "refTable",
          "fill": "$color/text",
          "textGrowth": "fixed-width",
          "width": 664,
          "content": "color/primary             →  --color-primary\ncolor/primary-hover       →  --color-primary-hover\ncolor/surface             →  --color-surface\ncolor/surface-muted       →  --color-surface-muted\ncolor/text                →  --color-text\ncolor/text-muted          →  --color-text-muted\ncolor/border              →  --color-border\ncolor/accent              →  --color-accent\n\nspace/xs                  →  --space-xs\nspace/sm                  →  --space-sm\nspace/md                  →  --space-md\nspace/lg                  →  --space-lg\nspace/xl                  →  --space-xl\nspace/2xl                 →  --space-2xl\n\nradius/sm                 →  --radius-sm\nradius/md                 →  --radius-md\nradius/lg                 →  --radius-lg\nradius/full               →  --radius-full\n\ntext/display              →  --text-display\ntext/h1                   →  --text-h1\ntext/h2                   →  --text-h2\ntext/h3                   →  --text-h3\ntext/h4                   →  --text-h4\ntext/body                 →  --text-body\ntext/small                →  --text-small\ntext/caption              →  --text-caption\n\nfont/display              →  --font-display\nfont/text                 →  --font-text\n\nfont-weight/display       →  --font-weight-display\nfont-weight/text          →  --font-weight-text\nfont-weight/text-bold     →  --font-weight-text-bold\n\nleading/display           →  --leading-display\nleading/text              →  --leading-text",
          "lineHeight": "$leading/text",
          "fontFamily": "monospace",
          "fontSize": "$text/small",
          "fontWeight": "$font-weight/text"
        }
      ]
    }
  ],
  "variables": {
    "color/accent": {
      "type": "color",
