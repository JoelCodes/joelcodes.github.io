                  "id": "vysqV",
                  "name": "qa-item-3 / Q",
                  "fill": "#141f39ff",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "What if I'm not sure exactly what I need?",
                  "lineHeight": 1.4,
                  "fontFamily": "Plus Jakarta Sans",
                  "fontSize": 32,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "oKRJQ",
                  "name": "qa-item-3 / A",
                  "fill": "#52525bff",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "That's what discovery is for. We'll talk through your challenges and I'll help clarify what solution makes sense.",
                  "lineHeight": 1.625,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
