                  "name": "qa-item-4 / Q",
                  "fill": "#141f39ff",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "How do you handle changes during the project?",
                  "lineHeight": 1.4,
                  "fontFamily": "Plus Jakarta Sans",
                  "fontSize": 32,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "oYSZ4",
                  "name": "qa-item-4 / A",
                  "fill": "#52525bff",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Small adjustments are normal. Larger scope changes are discussed together and may adjust the timeline or investment.",
                  "lineHeight": 1.625,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
