---
/**
 * Landing page — Phase 37, Plans 03-04
 *
 * Assembles all nine Figma landing sections from the wl/ component library.
 * All copy is verbatim from Figma 12:2 (light canonical, D-10).
 * Dark treatment from 117:103 (colors only, D-10).
 *
 * Sections in this file (37-03):
 *   1. Hero         — h1, FrequencyWave, CTAButton solid + ghost
 *   2. Who          — checkmark list
 *   3. Three-ways   — id="services", 3× ServiceCard
 *   4. How-it-works — 5× Step, kicker line
 *   5. Automations  — 4× flow row, kicker line
 *   6. Proof        — lead + credentials line
 *
 * Sections appended by 37-04: About (#about), Agencies, Final CTA.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOKING_URL, CONTACT_EMAIL } from '../lib/constants';
import CTAButton from '../components/wl/CTAButton.astro';
import Eyebrow from '../components/wl/Eyebrow.astro';
import ServiceCard from '../components/wl/ServiceCard.astro';
import Step from '../components/wl/Step.astro';
import FrequencyWave from '../components/wl/FrequencyWave.astro';
---

<BaseLayout title="Joel Shinness Solutions | Custom Software for Small Business">

  {/* ── Section 1: Hero ─────────────────────────────────────────────────────
      Background: vertical gradient #E6F1F1 → #D2E7E7 (sea-glass gradient).
      Dark: vertical gradient #123640 → #0C2228.
      Fixed 840px height, content vertically centered.
      FrequencyWave: absolutely positioned behind content (node 13:21).
      Horizontal padding: px-[160px] @1440, px-[400px] @1920, px-[32px] @768, px-[24px] @390.
      Source: 37-EXTRACTION.md §Section 1 Hero.
  ── */}
  <section
    style={[
      'position: relative;',
      'height: 840px;',
      'overflow: hidden;',
      'display: flex;',
      'align-items: center;',
      /* Light gradient: #E6F1F1 (sea-glass top) → #D2E7E7 (sea-glass-deep bottom) */
      'background: linear-gradient(to bottom, #E6F1F1, #D2E7E7);',
    ].join(' ')}
    class="dark:[background:linear-gradient(to_bottom,#123640,#0C2228)]"
  >
    {/* FrequencyWave: node 13:21 — left: -115px; top: -100px; w: 1670px; h: 1044px.
        absolutely positioned decorative background behind content.
        On-screen web equivalent: absolute with extracted pixel geometry. */}
    <FrequencyWave class="absolute pointer-events-none" style="left: -115px; top: -100px; width: 1670px; height: 1044px;" />

    {/* Hero content: centered, above the wave layer */}
    <div
      class="relative z-10 w-full px-[24px] sm:px-[32px] lg:px-[160px] xl:px-[400px]"
      style="max-width: none;"
    >
      {/* Eyebrow: "SOLUTIONS FOR SMALL BUSINESSES" (49:164) — gap 21px to h1 */}
      <Eyebrow>SOLUTIONS FOR SMALL BUSINESSES</Eyebrow>

      <div style="height: 21px;"></div>

      {/* h1: two lines. Line 1 static, line 2 mixed ink + accent italic + cursor bar.
          Source: 13:31 (line 1), 13:32 (line 2 rotor container), 13:33/13:34/13:35.
          Extraction gap: rotor-line animated behavior — building static per light frame.
          "time saved" is the sole word shown in all five Figma frames; no alternate words exist.
          [EXTRACTION GAP: rotor-line animated behavior resolved to static build — see 37-EXTRACTION.md] */}
      <h1
        class="wl-display-hero"
        style="color: var(--color-wl-ink); margin: 0;"
      >
        It's not just software.<br />
        <span>It's </span><span style="font-style: italic; color: var(--color-wl-accent);">time saved</span><span
          aria-hidden="true"
          style={[
            'display: inline-block;',
            'width: 2.5px;',
            'height: 0.85em;',
            'background: var(--color-wl-accent);',
            'vertical-align: middle;',
            'margin-left: 4px;',
          ].join(' ')}
        ></span>
      </h1>

      <div style="height: 26px;"></div>

      {/* Lead paragraph: node 13:37 (width 640 in Figma) */}
      <p
        class="wl-text-lead"
        style="color: var(--color-wl-sub); margin: 0; max-width: 640px;"
      >
        I build websites, automations, and practical AI that do real work for your business — give you back hours, cut costs, and show you what's actually going on. All my services are sized to your business: scoped to fix the problem, priced to pay for itself fast. You tell me what's eating your week — I'll get you your week back.
      </p>

      <div style="height: 38px;"></div>

      {/* CTAs: Book a call (solid + calendar) + Email me (ghost + mail). Gap 16px between.
          D-06: Calendly opens in new tab with rel="noopener". D-07: email via mailto. */}
      <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center;">
        <CTAButton
          href={BOOKING_URL}
          variant="solid"
          icon="calendar"
          target="_blank"
          rel="noopener"
        >
          Book a call
        </CTAButton>
        <CTAButton href={`mailto:${CONTACT_EMAIL}`} variant="ghost" icon="mail">
          Email me
        </CTAButton>
      </div>
    </div>
  </section>

  {/* ── Section 2: Who ──────────────────────────────────────────────────────
      Background: #F6FBFA (--wl-paper; dark flips via token).
      py-[112px] all breakpoints; standard gutters.
      Source: 37-EXTRACTION.md §Section 2 Who.
  ── */}
  <section
    style="background: var(--color-wl-paper); padding-top: 112px; padding-bottom: 112px;"
    class="px-[24px] sm:px-[32px] lg:px-[160px] xl:px-[400px]"
  >
    <div style="max-width: 1120px; margin: 0 auto;">
      {/* Eyebrow: "WHO IT'S FOR" (49:167) */}
      <Eyebrow>WHO IT'S FOR</Eyebrow>

      <div style="height: 21px;"></div>

      {/* h2: node 14:7, width 700 in Figma */}
      <h2
        class="wl-heading-h2"
        style="color: var(--color-wl-ink); margin: 0; max-width: 700px;"
      >
        You've got a business to run. The software should run itself.
      </h2>

      <div style="height: 18px;"></div>

      {/* Lead: node 14:9, width 700 */}
      <p
        class="wl-text-lead"
        style="color: var(--color-wl-sub); margin: 0; max-width: 700px;"
      >
        You know your business better than any consultant ever will — what you haven't had is time to build its tools. If any of these sound familiar, we should talk:
      </p>

      <div style="height: 32px;"></div>

      {/* Checkmark list: node 14:11. Column gap 14px between items.
          Row = 22px check icon + 13px gap + HG 17px var(--sub).
          Check icon: viewBox "0 0 22 22", stroke #0E7078 (accent), path M18.3333 5.5L8.25 15.5833L3.66667 11.
          Note: Figma 390 frame shows nowrap overflow — building with wrapping text (pre-approved deviation). */}
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px;">
        {[
          "You're tired of duct-taping spreadsheets and manual steps together.",
          "Your website is out of date, or quietly working against you.",
          "An agency quoted you enterprise prices for a small-business need.",
          "You want one reliable person, not a revolving team.",
        ].map((item) => (
          <li style="display: flex; align-items: flex-start; gap: 13px;">
            {/* Check icon: node 14:13, 22px, accent stroke */}
            <svg
              aria-hidden="true"
              width="22"
              height="22"
              viewBox="0 0 22 22"
              fill="none"
              stroke="var(--color-wl-accent)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              xmlns="http://www.w3.org/2000/svg"
              style="flex-shrink: 0; margin-top: 1px;"
            >
              <path d="M18.3333 5.5L8.25 15.5833L3.66667 11" />
            </svg>
            <span
              style={[
                'font-family: var(--font-wl-body);',
                'font-size: 17px;',
                'line-height: normal;',
                'color: var(--color-wl-sub);',
              ].join(' ')}
            >
              {item}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ── Section 3: Three-ways / Services ────────────────────────────────────
      id="services" — nav scroll target (/#services). scroll-margin-top: 64px via global.css.
      Background: vertical gradient #EFF7F6 → #E6F1F1. Top stop #EFF7F6 is a new literal (not a token).
      Dark: vertical gradient #10303A → #0E2B33 (custom dark literals).
      py-[112px] all breakpoints.
      Card grid: 3 equal columns, gap 22px at 1440/1920; stacked vertically gap 22px at 768/390.
      Source: 37-EXTRACTION.md §Section 3 Three-ways.
  ── */}
  <section
    id="services"
    style={[
      'padding-top: 112px;',
      'padding-bottom: 112px;',
      /* Light gradient: #EFF7F6 (new literal, not a token) → #E6F1F1 (sea-glass) */
      'background: linear-gradient(to bottom, #EFF7F6, #E6F1F1);',
    ].join(' ')}
    class="px-[24px] sm:px-[32px] lg:px-[160px] xl:px-[400px] dark:[background:linear-gradient(to_bottom,#10303A,#0E2B33)]"
  >
    <div style="max-width: 1120px; margin: 0 auto;">
      {/* Eyebrow: "WHAT I BUILD" (49:170) */}
      <Eyebrow>WHAT I BUILD</Eyebrow>

      <div style="height: 21px;"></div>

      {/* h2: node 14:33 */}
      <h2 class="wl-heading-h2" style="color: var(--color-wl-ink); margin: 0;">
        Three ways I help.
      </h2>

      <div style="height: 18px;"></div>

      {/* Lead: node 14:35, width 700 */}
      <p
        class="wl-text-lead"
        style="color: var(--color-wl-sub); margin: 0; max-width: 700px;"
      >
        Named the way you'd ask for them — described by what they do for your business.
      </p>

      <div style="height: 42px;"></div>

      {/* Card grid: 3 columns at ≥1024, stacked below. Gap 22px. */}
      <div
        class="grid grid-cols-1 lg:grid-cols-3"
        style="gap: 22px;"
      >
        {/* Card 1: Web (default variant) — node 14:38
            kicker (benefit): "Win more customers" / title: "Web" */}
        <ServiceCard
          variant="default"
          benefit="Win more customers"
          title="Web"
          body="From the site that earns their trust to the custom tools that run your day — booking, tracking, dashboards, portals — fast, modern, perfect on a phone, and built around how you actually work."
          headingLevel={3}
        >
          <Fragment slot="icon">
            {/* Web icon: node 14:40, viewBox 0 0 22 22, accent stroke */}
            <svg
              aria-hidden="true"
              width="22"
              height="22"
              viewBox="0 0 22 22"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M17.4167 3.66667H4.58333C3.57081 3.66667 2.75 4.48748 2.75 5.5V14.6667C2.75 15.6792 3.57081 16.5 4.58333 16.5H17.4167C18.4292 16.5 19.25 15.6792 19.25 14.6667V5.5C19.25 4.48748 18.4292 3.66667 17.4167 3.66667Z" />
              <path d="M2.75 7.33333H19.25M6.41667 18.3333H15.5833" />
            </svg>
          </Fragment>
        </ServiceCard>

        {/* Card 2: Automations (default variant) — node 14:49
            benefit: "Get hours back, every week" / title: "Automations" */}
        <ServiceCard
          variant="default"
          benefit="Get hours back, every week"
          title="Automations"
          body="The tools you already use, wired together so data moves itself — no copy-pasting between apps, no forgotten follow-ups, no busywork."
          headingLevel={3}
        >
          <Fragment slot="icon">
            {/* Automations icon: node 14:66, viewBox 0 0 22 22, accent stroke */}
            <svg
              aria-hidden="true"
              width="22"
              height="22"
              viewBox="0 0 22 22"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M4.58333 7.33333C5.59586 7.33333 6.41667 6.51252 6.41667 5.5C6.41667 4.48748 5.59586 3.66667 4.58333 3.66667C3.57081 3.66667 2.75 4.48748 2.75 5.5C2.75 6.51252 3.57081 7.33333 4.58333 7.33333Z" />
              <path d="M4.58333 18.3333C5.59586 18.3333 6.41667 17.5125 6.41667 16.5C6.41667 15.4875 5.59586 14.6667 4.58333 14.6667C3.57081 14.6667 2.75 15.4875 2.75 16.5C2.75 17.5125 3.57081 18.3333 4.58333 18.3333Z" />
              <path d="M17.4167 12.8333C18.4292 12.8333 19.25 12.0125 19.25 11C19.25 9.98748 18.4292 9.16667 17.4167 9.16667C16.4041 9.16667 15.5833 9.98748 15.5833 11C15.5833 12.0125 16.4041 12.8333 17.4167 12.8333Z" />
              <path d="M6.41667 5.5H10.0833C11.0558 5.5 11.9884 5.88631 12.6761 6.57394C13.3637 7.26158 13.75 8.19421 13.75 9.16667M6.41667 16.5H10.0833C11.0558 16.5 11.9884 16.1137 12.6761 15.4261C13.3637 14.7384 13.75 13.8058 13.75 12.8333" />
            </svg>
          </Fragment>
        </ServiceCard>

        {/* Card 3: AI (highlight variant) — node 14:62
            kicker pill: "ALL THE HELP, NONE OF THE HYPE" (14:63)
            benefit: "The judgment work, handled" / title: "AI"
            Pill alignment: centered per canonical 1440 (divergence logged — D-10 batch). */}
        <ServiceCard
          variant="highlight"
          kicker="ALL THE HELP, NONE OF THE HYPE"
          benefit="The judgment work, handled"
          title="AI"
          body="Straight answers on where AI actually pays off in your business — and where it doesn't. Then I put it to work inside your workflow: reading, sorting, drafting, summarizing the stuff that used to need a person."
          headingLevel={3}
        >
          <Fragment slot="icon">
            {/* AI icon: node 61:615, viewBox 0 0 22 22, accent stroke */}
            <svg
              aria-hidden="true"
              width="22"
              height="22"
              viewBox="0 0 22 22"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M11 2.75L12.742 7.883L17.875 9.625L12.742 11.367L11 16.5L9.258 11.367L4.125 9.625L9.258 7.883L11 2.75Z" />
              <path d="M17.417 3.208V5.958M16.042 4.583H18.792" />
            </svg>
          </Fragment>
        </ServiceCard>
      </div>
    </div>
  </section>

  {/* ── Section 4: How-it-works ──────────────────────────────────────────────
      Background: #F6FBFA (--wl-paper; dark flips via token).
      py-[112px] all breakpoints.
      5 equal columns at 1440/1920, stacked at 768/390. Gap 26px.
      h2 → steps gap 45px (no lead para for this section).
      Kicker line: Fraunces Italic 20px INK (not accent — extraction confirmed), gap 29px above.
      Source: 37-EXTRACTION.md §Section 4 How-it-works.
  ── */}
  <section
    style="background: var(--color-wl-paper); padding-top: 112px; padding-bottom: 112px;"
    class="px-[24px] sm:px-[32px] lg:px-[160px] xl:px-[400px]"
  >
    <div style="max-width: 1120px; margin: 0 auto;">
      {/* Eyebrow: "HOW IT WORKS" (49:173) */}
      <Eyebrow>HOW IT WORKS</Eyebrow>

      <div style="height: 21px;"></div>

      {/* h2: node 15:7. h2→steps gap 45px (no lead). */}
      <h2 class="wl-heading-h2" style="color: var(--color-wl-ink); margin: 0;">
        What working together actually looks like.
      </h2>

      <div style="height: 45px;"></div>

      {/* Steps: 5 columns at lg, stacked below. Gap 26px.
          Step component wraps inside li; parent provides ol semantics. */}
      <ol
        class="grid grid-cols-1 lg:grid-cols-5"
        style="gap: 26px; list-style: none; margin: 0; padding: 0;"
      >
        <li>
          <Step number={1} title="Discovery call">
            We talk about what's top of mind — the problems costing you time and money right now.
          </Step>
        </li>
        <li>
          <Step number={2} title="Design meeting">
            We talk solutions. I bring options; you pick what fits how you actually work.
          </Step>
        </li>
        <li>
          <Step number={3} title="Proposal & pricing">
            You'll know what it costs before I start building — a clear scope, a real number, and the reasoning behind both. You decide with the full picture.
          </Step>
        </li>
        <li>
          <Step number={4} title="Development">
            Built in short cycles and shown to you working the whole way — not a slideshow, the real thing. You react, I adjust, we repeat until it does the job right.
          </Step>
        </li>
        <li>
          <Step number={5} title="Support mode">
            It's live and earning its keep. Need a change? You've got a person, not a ticket queue.
          </Step>
        </li>
      </ol>

      {/* Kicker line: node 61:613. Fraunces Italic 20px, color INK (not accent).
          Gap 29px above. This is the ink-colored variant — not .wl-accent-kicker (which is accent-colored).
          Local inline override for ink color per extraction. */}
      <div style="height: 29px;"></div>
      <p
        style={[
          'font-family: var(--font-wl-heading);',
          'font-size: 20px;',
          'font-style: italic;',
          'line-height: normal;',
          'font-weight: 400;',
          'font-variation-settings: "SOFT" 0, "WONK" 1;',
          'color: var(--color-wl-ink);',
          'margin: 0;',
        ].join(' ')}
      >
        And every conversation along the way carries a standing question: is there a new way I can make your life easier?
      </p>
    </div>
  </section>

  {/* ── Section 5: Automations ───────────────────────────────────────────────
      Background: vertical gradient #E6F1F1 → #DCEDEC. Bottom stop #DCEDEC is a new literal.
      Dark: vertical gradient #0E2B33 → #0D262E.
      py-[112px] all breakpoints.
      Flow list: full-width rows, column gap 16px.
      Flow row: white card (--wl-card-bg), border wl-line, radius 14, px 24/py 18.
      Horizontal flex at 1440: trigger (flex-1) → arrow (24px) → result (flex-1).
      Vertical stack at 768/390 with 90°-rotated arrow.
      Kicker: Fraunces Italic 20px INK, gap 29px above.
      Source: 37-EXTRACTION.md §Section 5 Automations.
  ── */}
  <section
    style={[
      'padding-top: 112px;',
      'padding-bottom: 112px;',
      /* Light gradient: #E6F1F1 → #DCEDEC (new bottom literal) */
      'background: linear-gradient(to bottom, #E6F1F1, #DCEDEC);',
    ].join(' ')}
    class="px-[24px] sm:px-[32px] lg:px-[160px] xl:px-[400px] dark:[background:linear-gradient(to_bottom,#0E2B33,#0D262E)]"
  >
    <div style="max-width: 1120px; margin: 0 auto;">
      {/* Eyebrow: "WHAT THAT LOOKS LIKE" (49:176) */}
      <Eyebrow>WHAT THAT LOOKS LIKE</Eyebrow>

      <div style="height: 21px;"></div>

      {/* h2: node 15:33, width 800 */}
      <h2
        class="wl-heading-h2"
        style="color: var(--color-wl-ink); margin: 0; max-width: 800px;"
      >
        If you do it by hand every week, it can probably do itself.
      </h2>

      <div style="height: 18px;"></div>

      {/* Lead: node 15:35, width 700 */}
      <p
        class="wl-text-lead"
        style="color: var(--color-wl-sub); margin: 0; max-width: 700px;"
      >
        The highest-value, least-glamorous work I do — quietly saving you time and money. A few real examples:
      </p>

      <div style="height: 42px;"></div>

      {/* Flow list: 4 rows, column gap 16px */}
      <div style="display: flex; flex-direction: column; gap: 16px;">
        {[
          { trigger: "A new enquiry comes in",   result: "Logged, sorted, and pinged to your phone — no lead slips through." },
          { trigger: "A customer books online",  result: "Calendar updated, confirmation sent, reminder scheduled — zero manual steps." },
          { trigger: "Month-end rolls around",   result: "Your numbers pulled into one clean summary — hours back, and a clearer picture of the business." },
          { trigger: "An invoice gets paid",     result: "Recorded, receipt sent, next step triggered — your books stay current on their own." },
        ].map(({ trigger, result }) => (
          <div
            style={[
              /* Flow row card: white card bg (--wl-card-bg), border wl-line, radius 14, px 24/py 18 */
              'background: var(--wl-card-bg);',
              'border: 1px solid var(--color-wl-line);',
              'border-radius: 14px;',
              'padding: 18px 24px;',
            ].join(' ')}
          >
            {/* Horizontal layout at md+, vertical stack at sm */}
            <div class="flex flex-col sm:flex-row sm:items-center sm:gap-[19px]">
              {/* Trigger: HG Regular 16px lh 1.6, sub color, flex-1 */}
              <span
                class="wl-text-body"
                style="color: var(--color-wl-sub); flex: 1;"
              >
                {trigger}
              </span>

              {/* Arrow icon: 24px, accent stroke. Rotated 90° (pointing down) at sm/mobile. */}
              <svg
                aria-hidden="true"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-wl-accent)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                xmlns="http://www.w3.org/2000/svg"
                class="rotate-90 sm:rotate-0 my-[8px] sm:my-0 flex-shrink-0"
              >
                <path d="M5 12H19M13 18L19 12L13 6" />
              </svg>

              {/* Result: HG SemiBold 16px lh 1.6, ink color, flex-1 */}
              <span
                class="wl-text-body"
                style="color: var(--color-wl-ink); font-weight: 600; flex: 1;"
              >
                {result}
              </span>
            </div>
          </div>
        ))}
      </div>

      {/* Kicker: node 15:59. Fraunces Italic 20px, INK color. Gap 29px above. */}
      <div style="height: 29px;"></div>
      <p
        style={[
          'font-family: var(--font-wl-heading);',
          'font-size: 20px;',
          'font-style: italic;',
          'line-height: normal;',
          'font-weight: 400;',
          'font-variation-settings: "SOFT" 0, "WONK" 1;',
          'color: var(--color-wl-ink);',
          'margin: 0;',
        ].join(' ')}
      >
        Tell me the thing you dread doing every week. That's usually the first one to solve.
      </p>
    </div>
  </section>

  {/* ── Section 6: Proof ────────────────────────────────────────────────────
      Background: #F6FBFA (--wl-paper; dark flips via token).
      py-[112px] all breakpoints.
      No stats, no testimonials, no Badge/Callout — extraction confirmed prose only.
      Credentials line: 15px, SemiBold prefix (ink) + Regular companies (#4C6A70 light / #8FB4B2 dark).
      Gap: lead → credentials 32px, span gap 4px within line.
      Source: 37-EXTRACTION.md §Section 6 Proof.
  ── */}
  <section
    style="background: var(--color-wl-paper); padding-top: 112px; padding-bottom: 112px;"
    class="px-[24px] sm:px-[32px] lg:px-[160px] xl:px-[400px]"
  >
    <div style="max-width: 1120px; margin: 0 auto;">
      {/* Eyebrow: "WHY TRUST ME WITH IT" (49:179) */}
      <Eyebrow>WHY TRUST ME WITH IT</Eyebrow>

      <div style="height: 21px;"></div>

      {/* h2: node 16:7 */}
      <h2 class="wl-heading-h2" style="color: var(--color-wl-ink); margin: 0;">
        I build solutions people rely on.
      </h2>

      <div style="height: 18px;"></div>

