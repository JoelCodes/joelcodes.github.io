{/* Hero rotor: blink the cursor while idle, hold it steady while typing/deleting.
    Reduced motion disables the blink (JS also bails, leaving static "time saved"). */}
<style>
  /* Grid-stack: ghost and real line share one cell; h1 height = tallest of the two,
     so short rotor phrases can't shrink the block and bounce the layout below. */
  .hero-h1 { display: grid; }
  .hero-h1 > .hero-line { grid-area: 1 / 1; }
  .hero-line-ghost { visibility: hidden; }

  .hero-cursor { animation: hero-blink 1s step-end infinite; }
  .hero-cursor.is-typing { animation: none; opacity: 1; }
  @keyframes hero-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .hero-cursor { animation: none; opacity: 1; }
  }
</style>

<script>
  // Typing rotor for the hero line. Vanilla, no deps. Starts from the static
  // "time saved" already in the DOM, so no-JS and reduced-motion keep that word.
  const rotor = document.getElementById('hero-rotor');
  const cursor = document.getElementById('hero-cursor');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (rotor && cursor && !reduce) {
    const WORDS = ['time saved', 'money saved', 'happier customers', 'sharper insight', 'fewer headaches'];
    const TYPE_MS = 75;   // per-char while typing
    const DEL_MS = 40;    // per-char while deleting (quicker, per spec)
    const HOLD_MS = 1800; // pause on a fully-typed word
    const NEXT_MS = 500;  // pause on empty before the next word

    let wi = 0;                    // current word index (0 = "time saved", already shown)
    let ci = WORDS[0].length;      // chars currently rendered
    let deleting = false;

    const steady = (on: boolean) => cursor.classList.toggle('is-typing', on);

    const step = () => {
      const word = WORDS[wi];
      if (!deleting) {
        if (ci < word.length) {
          rotor.textContent = word.slice(0, ++ci);
          steady(true);
          setTimeout(step, TYPE_MS);
        } else {
          steady(false);                                   // blink while holding
          setTimeout(() => { deleting = true; step(); }, HOLD_MS);
        }
      } else {
        if (ci > 0) {
          rotor.textContent = word.slice(0, --ci);
          steady(true);
          setTimeout(step, DEL_MS);
        } else {
          deleting = false;
          wi = (wi + 1) % WORDS.length;
          steady(false);                                   // blink on the gap
          setTimeout(step, NEXT_MS);
        }
      }
    };

    step();
  }
</script>
