---
/**
 * Blog post page — Phase 38, Plan 06 (PAGE-06)
 *
 * Re-baselined 2026-07-19 against canonical Figma page 195:210 / frame 195:211
 * ("Site · Blog Post" — 38-BLOG-EXTRACTION.md §5-8, 38-BLOG-FRAMES.md).
 * The prior draft frame (211:5/211:6 "Blog Post") is deleted from Figma — all values
 * in this file are sourced from the canonical 195:211 frame.
 *
 * Dev-gated: returns [] in getStaticPaths when PROD (D-13).
 *
 * Sections (195:211 layout order):
 *   §5 Hero      — FrequencyWave + sea-glass gradient + Breadcrumb + meta row + h1 + lead
 *   §6 Article   — .wl-prose centered at max-width 735px (canonical prose column)
 *   §7 Author    — sea-glass gradient band + AuthorCard component
 *   §8 Related   — paper bg + Eyebrow "KEEP READING" + h2 + 2× BlogCard variant="mini"
 *
 * NO featured image rendered above the fold (Joel decision per 38-BLOG-FRAMES.md):
 *   featuredImage stays in schema for og:image meta ONLY (wired via <slot name="head">).
 *   LCP element is the hero text/band — roadmap criterion 3 lazy-image bug is moot
 *   (no featured <img> renders on the post page at all).
 *
 * Read time: computed from post body word count via src/lib/reading-time.ts.
 * Post h1: Fraunces 54px / 1.06 / local (source node 195:224, no ramp match — §11).
 * Zero old neobrutalist tokens.
 */

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/wl/Breadcrumb.astro';
import Eyebrow from '../../components/wl/Eyebrow.astro';
import Tag from '../../components/wl/Tag.astro';
import FrequencyWave from '../../components/wl/FrequencyWave.astro';
import AuthorCard from '../../components/wl/AuthorCard.astro';
import BlogCard from '../../components/wl/BlogCard.astro';
import { readingMinutes } from '../../lib/reading-time';

export async function getStaticPaths() {
  if (import.meta.env.PROD) return [];  // No blog pages in production (D-13)
  // Dev only (guard above): generate a page for every post INCLUDING drafts, so an
  // author can preview a draft by its direct URL. Drafts are excluded from listings
  // (index/grid/related/tags), so nothing links here — this is preview-only.
  const posts = await getCollection('blog');

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Compute read time from body word count (ceil(words/200)).
const readMins = readingMinutes(post.body ?? '');

// Format date: "Month D, YYYY" (source node 197:69 meta row format).
const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

// Related posts: up to 2 other posts sharing ≥1 tag (fallback: most-recent others).
// Drafts are excluded everywhere — the "Related posts." section (guarded below on
// relatedPosts.length) is omitted entirely when no other published post exists.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const otherPosts = allPosts
  .filter(p => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Tag-matching: posts sharing at least 1 tag with the current post.
const postTags = post.data.tags ?? [];
const tagMatched = postTags.length > 0
  ? otherPosts.filter(p => (p.data.tags ?? []).some(t => postTags.includes(t)))
  : [];

// Fallback to most-recent other posts when tag-matched count < 2.
const relatedRaw = tagMatched.length >= 2
  ? tagMatched.slice(0, 2)
  : [
      ...tagMatched,
      ...otherPosts.filter(p => !tagMatched.includes(p))
    ].slice(0, 2);

const relatedPosts = relatedRaw;

// First tag for meta row (source 196:1092 — one tag pill in hero meta).
const firstTag = postTags[0] ?? null;

// SITE_URL for og:image absolute URL.
const SITE_URL = 'https://joelshinness.com';
---

<BaseLayout title={post.data.title} description={post.data.description}>
  {/* og:image meta: pass featuredImage as OG image for social sharing.
      featuredImage DROPS from the page layout (Joel decision per 38-BLOG-FRAMES.md)
      but is preserved in schema for og:image ONLY (38-BLOG-FRAMES.md: "schema for OG/social meta only").
      Wired via <slot name="head"> to avoid overwriting the base SEO component. */}
  {post.data.featuredImage && (
    <meta
      slot="head"
      property="og:image"
      content={`${SITE_URL}${post.data.featuredImage}`}
    />
  )}

  {/* ── §5 Hero (195:213) ────────────────────────────────────────────────────
      Background (light): #E6F1F1 → #D2E7E7 (195:213 fill = same as index hero 195:105).
      Background (dark, DERIVED D-04): #123640 → #0C2228.
      Rule 1: background in class.
      FrequencyWave: 1670×1044 at left:-115 top:-100 (195:214 = 195:106 = 13:21 geometry).
      Section height: min-h 480px (prior metadata — FIDELITY-GAP: design context reports size-full).
      Gutters: landing pattern.
  ── */}
  <section
    class="relative overflow-hidden flex items-center px-[24px] sm:px-[32px] lg:px-[160px] min-[1920px]:px-[400px] [background:linear-gradient(to_bottom,#E6F1F1,#D2E7E7)] dark:[background:linear-gradient(to_bottom,#123640,#0C2228)]"
    style="min-height: 480px;"
  >
    {/* FrequencyWave: node 195:214 — same geometry as 195:106 / 13:21 (§10).
        Wrapped in a positioned div to avoid the style= TS error (FrequencyWave only accepts class=). */}
    <div class="absolute pointer-events-none" style="left: -115px; top: -100px; width: 1670px; height: 1044px;">
      <FrequencyWave class="w-full h-full" />
    </div>

    {/* Hero content: above wave layer */}
    <div class="relative z-10 w-full" style="max-width: 1120px; margin: 0 auto; padding-top: 72px; padding-bottom: 72px;">

      {/* Breadcrumb: 3 levels — Home / Blog / {post title short} (source node 195:220).
          Per §5: "Home / Blog / The spreadsheet test" — 3 levels with current-post title. */}
      <Breadcrumb
        items={[
          { label: 'Home', href: '/' },
          { label: 'Blog', href: '/blog' },
          { label: post.data.title },
        ]}
      />

      {/* gap breadcrumb → meta: 20px (195:221 spacer) */}
      <div style="height: 20px;" aria-hidden="true"></div>

      {/* Meta row (196:1091): Tag pill + date + · (accent-soft) + "{N} min read"
          Gap 11 (source 196:1091). Format: "{Month D, YYYY} · {N} min read".
          Separator · in accent-soft color (197:70 / 196:1094). */}
      <div class="post-meta-row">
        {firstTag && (
          <a href={`/blog/tags/${encodeURIComponent(firstTag)}`} style="text-decoration: none;">
            <Tag>{firstTag}</Tag>
          </a>
        )}
        <time
          datetime={post.data.pubDate.toISOString()}
          class="post-meta-date"
        >
          {formattedDate}
        </time>
        <span class="post-meta-sep" aria-hidden="true">·</span>
        <span class="post-meta-readtime">{readMins} min read</span>
      </div>

      {/* gap meta → h1: 21px (195:223 spacer) */}
      <div style="height: 21px;" aria-hidden="true"></div>

      {/* h1: post title — source node 195:224.
          Style: Fraunces Regular 54px / 1.06 / ink / SOFT 0 WONK 1 / width 980.
          NO ramp match (ramp has 61 interior / 50 h2; 54 is between them) → local style.
          Source-node comment per Phase 36/38 precedent. 390 derived: 34–40px range → 36px. */}
      <h1 class="post-h1" style="color: var(--color-wl-ink); margin: 0; max-width: 980px;">
        {post.data.title}
      </h1>

      {/* gap h1 → lead: 26px (195:225 spacer) */}
      <div style="height: 26px;" aria-hidden="true"></div>

      {/* Lead: post description (maps to frame's lead, source node 195:226).
          Style: HG Regular 21px / 1.6, sub, width 700 → .wl-text-lead EXACT MATCH (§11). */}
      <p
        class="wl-text-lead"
        style="color: var(--color-wl-sub); margin: 0; max-width: 700px;"
      >
        {post.data.description}
      </p>
    </div>
  </section>

  {/* ── §6 Article prose (197:1017) ──────────────────────────────────────────
      Prose column: max-width 735px centered (frame metadata; wave figure 200:1007 = 735 wide).
      Background: var(--color-wl-paper) (token flips in .dark).
      No featured image — Joel decision (38-BLOG-FRAMES.md "featured images DROP from post layout").
      The corrected .wl-prose (Plan 05 / global.css) handles all elements.
  ── */}
  <section
    style="background: var(--color-wl-paper); padding-top: 96px; padding-bottom: 96px;"
    class="px-[24px] sm:px-[32px] lg:px-[160px] min-[1920px]:px-[400px]"
  >
    <article style="max-width: 735px; margin: 0 auto;">
      <div class="wl-prose">
        <Content />
      </div>
    </article>
  </section>

  {/* ── §7 Author band (200:1015) ────────────────────────────────────────────
      Background (light): #E6F1F1 → #D2E7E7 (200:1015 fill = same sea-glass gradient).
      Background (dark, DERIVED D-04): #123640 → #0C2228.
      Rule 1: background in class.
      Padding: py 112 (same as CTA bands — source 200:1015).
      Layout: items-center (card is centered — 200:1016 width 760).
      AuthorCard component carries eyebrow / name / bio / CTAs (Plan 05 foundation).
  ── */}
  <section
    class="px-[24px] sm:px-[32px] lg:px-[160px] min-[1920px]:px-[400px] [background:linear-gradient(to_bottom,#E6F1F1,#D2E7E7)] dark:[background:linear-gradient(to_bottom,#123640,#0C2228)]"
    style="padding-top: 112px; padding-bottom: 112px;"
  >
    <div style="display: flex; justify-content: center;">
      <AuthorCard />
    </div>
  </section>

  {/* ── §8 Related posts (200:1043) ──────────────────────────────────────────
      Background (light): #F6FBFA = var(--color-wl-paper) — 200:1043 fill.
      Background (dark, DERIVED): #0C2228 — paper token flip.
      Padding: py 96; gap 38 (header → cards — NOT the 42 used elsewhere; source 200:1043).
      Header: gap 21, Eyebrow "KEEP READING" → h2 "Related posts." (200:1044/200:1048).
      Cards: up to 2 BlogCard variant="mini" in a 2-col row, gap 22 (200:1049).
      Section hidden when relatedPosts.length === 0.
  ── */}
  {relatedPosts.length > 0 && (
    <section
      style="background: var(--color-wl-paper); padding-top: 96px; padding-bottom: 96px;"
      class="px-[24px] sm:px-[32px] lg:px-[160px] min-[1920px]:px-[400px]"
    >
      <div style="max-width: 1120px; margin: 0 auto;">

        {/* Section header: gap 21, Eyebrow + h2 (200:1044). Gap to cards: 38px (200:1043). */}
        <div style="display: flex; flex-direction: column; gap: 21px; margin-bottom: 38px;">
          {/* Eyebrow: "KEEP READING" — source node 200:1045 (VERBATIM) */}
          <Eyebrow>KEEP READING</Eyebrow>

          {/* h2: "Related posts." — source node 200:1048 (VERBATIM).
              Style: Fraunces 50 / 1.06 → .wl-heading-h2 (§11; tracking caveat logged). */}
          <h2 class="wl-heading-h2" style="color: var(--color-wl-ink); margin: 0;">
            Related posts.
          </h2>
        </div>

        {/* 2-up mini-card row: gap 22 (200:1049). Each card ≈ 549px (2 × 549 + 22 = 1120 ✓).
            Responsive: stack to 1-col at mobile. */}
        <ul
          role="list"
          class="related-grid"
          style="list-style: none; margin: 0; padding: 0;"
        >
          {relatedPosts.map((related) => (
            <li class="related-grid-item">
              <BlogCard
                variant="mini"
                title={related.data.title}
                description={related.data.description}
                url={`/blog/${related.id}`}
                tags={related.data.tags}
                pubDate={related.data.pubDate}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* ── Post hero h1 — Fraunces 54px (source node 195:224) ────────────────────
     No ramp match (61 interior / 50 h2; 54 is between) → local.
     390: 36px derived (between 34 and 40 from §11 range guidance). */
  .post-h1 {
    font-family: var(--font-wl-heading);
    font-size: 54px; /* source node 195:224 — Fraunces 54/1.06; no ramp match */
    font-weight: 400;
    line-height: 1.06;
    font-optical-sizing: auto;
    font-style: normal;
    font-variation-settings: "SOFT" 0, "WONK" 1;
    /* No letter-spacing attr on 195:224 — accepted per §11 tracking-delta log */
  }

  @media (max-width: 390px) {
    .post-h1 {
      font-size: 36px; /* derived — within the 34–40px range from §11 guidance; no 390 canonical frame */
    }
  }

  /* ── Meta row (196:1091): flex row, gap 11 ──────────────────────────────── */
  .post-meta-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 11px; /* source node 196:1091 */
    flex-wrap: wrap;
  }

  /* Date: HG Regular 14px, #4C6A70 (dark #A9C9C7 DERIVED via --wl-breadcrumb-color).
     Source nodes 197:69 / 196:1093 — crumb-tint treatment (§11). */
  .post-meta-date,
  .post-meta-readtime {
    font-family: var(--font-wl-body);
    font-size: 14px; /* source nodes 197:69 / 196:1093 */
    font-weight: 400;
    line-height: 1.5;
    color: var(--wl-breadcrumb-color); /* #4C6A70 / #A9C9C7 dark — token flip */
  }

  /* Separator · in accent-soft (197:70 / 196:1094): #5AA9A5 / #7FC4C0 dark */
  .post-meta-sep {
    font-family: var(--font-wl-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-wl-accent-soft); /* token flips */
  }

  /* ── 2-col related mini-cards row ─────────────────────────────────────── */
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px; /* source 200:1049 — 2 × 549 + 22 = 1120 ✓ */
  }

  @media (max-width: 640px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  .related-grid-item {
    min-width: 0;
  }
</style>
