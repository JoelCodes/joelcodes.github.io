---
/**
 * Blog tag page — Phase 38, Plan 06 (PAGE-06, D-10)
 *
 * Derived surface: index layout + filtered heading.
 * Dev-gated: returns [] in getStaticPaths when PROD (D-13).
 *
 * Frame authority: Derived surface — no separate frame comparison.
 * Uses same wl/BlogCard editorial list as blog/index.astro.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/wl/BlogCard.astro';
import Breadcrumb from '../../../components/wl/Breadcrumb.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  if (import.meta.env.PROD) return [];  // No blog pages in production (D-13)
  const allPosts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  // Get unique tags from all posts
  const uniqueTags = [...new Set(allPosts.flatMap(post => post.data.tags))];

  return uniqueTags.map(tag => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts
        .filter(post => post.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    }
  }));
}

const { tag, posts } = Astro.props;

// Format tag for display (capitalize first letter)
const displayTag = tag.charAt(0).toUpperCase() + tag.slice(1);
---

<BaseLayout
  title={`Posts tagged "${displayTag}" | Joel Shinness`}
  description={`All blog posts about ${displayTag}. Practical insights on automation, AI, and custom software for small businesses.`}
>

  {/* ── Page hero (derived — index layout with filtered heading) ─────────────
      Sea-glass gradient + Eyebrow pattern from Blog Index hero (211:3).
      Heading announces tag context per D-10 "filtered heading".
  ── */}
  <section
    class="px-[24px] sm:px-[32px] lg:px-[160px] min-[1920px]:px-[400px] [background:linear-gradient(to_bottom,#E6F1F1,#D2E7E7)] dark:[background:linear-gradient(to_bottom,#123640,#0C2228)]"
    style="padding-top: 88px; padding-bottom: 72px;"
  >
    <div style="max-width: 1120px; margin: 0 auto;">

      {/* Breadcrumb back-link: Blog → {displayTag} */}
      <Breadcrumb
        items={[
          { label: 'Blog', href: '/blog' },
          { label: displayTag }
        ]}
      />

      <div style="height: 21px;"></div>

      {/* h1: "Posts tagged '{displayTag}'" — filtered heading per D-10 */}
      <h1
        style={[
          'font-family: var(--font-wl-heading);',
          'font-size: 64px;',
          'font-weight: 400;',
          'line-height: 1.06;',
          'font-style: normal;',
          'font-variation-settings: "SOFT" 0, "WONK" 1;',
          'color: var(--color-wl-ink);',
          'margin: 0;',
        ].join(' ')}
      >
        Posts tagged "{displayTag}"
      </h1>

      <div style="height: 18px;"></div>

      <p
        class="wl-text-lead"
        style="color: var(--color-wl-sub); margin: 0;"
      >
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged {displayTag.toLowerCase()}.
      </p>
    </div>
  </section>

  {/* ── Editorial post list (same pattern as blog/index.astro) ───────────── */}
  <main
    style="background: var(--color-wl-paper); padding-top: 112px; padding-bottom: 112px;"
    class="px-[24px] sm:px-[32px] lg:px-[160px] min-[1920px]:px-[400px]"
  >
    <div style="max-width: 1120px; margin: 0 auto;">
      {posts.length === 0 ? (
        <p style="color: var(--color-wl-sub);">No posts found with this tag.</p>
      ) : (
        <ul role="list" class="blog-index-list" style="list-style: none; margin: 0; padding: 0;">
          {posts.map((post) => (
            <li class="blog-index-item">
              <BlogCard
                title={post.data.title}
                slug={post.id}
                pubDate={post.data.pubDate}
                description={post.data.description}
                featuredImage={post.data.featuredImage}
                tags={post.data.tags}
              />
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>

</BaseLayout>

<style>
  /* Entry hairline dividers — matching blog/index.astro */
  .blog-index-item + .blog-index-item {
    border-top: 1px solid var(--color-wl-line);
  }

  .blog-index-item {
    padding-top: 32px;
    padding-bottom: 32px;
  }

  .blog-index-item:first-child {
    padding-top: 0;
  }

  .blog-index-item:last-child {
    padding-bottom: 0;
  }
</style>
