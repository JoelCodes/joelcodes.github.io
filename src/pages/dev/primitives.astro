---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/wl/CTAButton.astro';
import Eyebrow from '../../components/wl/Eyebrow.astro';
import Tag from '../../components/wl/Tag.astro';
import Callout from '../../components/wl/Callout.astro';
import LinkCard from '../../components/wl/LinkCard.astro';
import Breadcrumb from '../../components/wl/Breadcrumb.astro';
import Step from '../../components/wl/Step.astro';
import ServiceCard from '../../components/wl/ServiceCard.astro';

if (import.meta.env.PROD) {
  return Astro.redirect('/');  // DEV-gate: isolation page never ships to production (T-01, D-14)
}

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/#services' },
  { label: 'Web Development' },
];
---

<BaseLayout title="Dev: Primitives - Phase 35" description="DEV-only isolation page for Phase 35 UI primitive verification.">
  <main>

    <section style="background: var(--color-wl-paper); padding: 64px 48px;">
      <div style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 48px;">

        <h2 style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-wl-sub); margin: 0; padding-bottom: 8px; border-bottom: 1px solid var(--color-wl-line);">
          Phase 35 UI Primitives - Figma 36:5 order (light surface)
        </h2>

        <div>
          <p style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-wl-sub); margin: 0 0 16px 0;">
            CTA Button - 4 variants + icon combos
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center;">
            <CTAButton href="/#book" variant="solid" icon="calendar">Book a call</CTAButton>
            <CTAButton href="/#book" variant="solid" icon="mail">Send a message</CTAButton>
            <CTAButton href="/#book" variant="solid">Book a call</CTAButton>
            <CTAButton href="/#book" variant="ghost" icon="calendar">Book a call</CTAButton>
            <CTAButton href="/#book" variant="ghost">Learn more</CTAButton>
            <CTAButton href="/#book" variant="small">Book a call</CTAButton>
          </div>
        </div>

        <div>
          <p style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-wl-sub); margin: 0 0 16px 0;">
            Eyebrow - on-light
          </p>
          <Eyebrow>What I build</Eyebrow>
        </div>

        <div>
          <p style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-wl-sub); margin: 0 0 16px 0;">
            Tag (pill)
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
            <Tag>AI workflows</Tag>
            <Tag>Web apps</Tag>
            <Tag>Automation</Tag>
          </div>
        </div>

        <div>
          <p style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-wl-sub); margin: 0 0 16px 0;">
            Callout (aside + accent left bar)
          </p>
          <div style="max-width: 700px;">
            <Callout>
              This is what I build: custom software, AI workflows, and automation that give small
              businesses the leverage of a full engineering team without the overhead.
            </Callout>
          </div>
        </div>

        <div>
          <p style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-wl-sub); margin: 0 0 16px 0;">
            LinkCard (cross-link mini card)
          </p>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
            <LinkCard
              href="/showcase"
              title="See what I've built"
              outcome="Real projects, real results"
              goLabel="View showcase"
            >
              A curated selection of web apps, automations, and AI tools built for small businesses
              across Canada.
            </LinkCard>
            <LinkCard
              href="/#services"
              title="Web apps that do the work"
              outcome="Custom development"
              goLabel="Explore services"
            >
              From intake forms to full client portals built to your workflow, not a template.
            </LinkCard>
          </div>
        </div>

        <div>
          <p style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-wl-sub); margin: 0 0 16px 0;">
            Breadcrumb (WAI-ARIA nav + ol)
          </p>
          <Breadcrumb items={breadcrumbItems} />
        </div>

        <div>
          <p style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-wl-sub); margin: 0 0 16px 0;">
            Step (bare Fraunces numeral, li-compatible - wrapped in ol)
          </p>
          <ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 32px;">
            <li>
              <Step number={1} title="Tell me what you need">
                A quick call or message is all it takes. I will ask about your workflow, your
                bottlenecks, and what success looks like for you.
              </Step>
            </li>
            <li>
              <Step number={2} title="I build it fast">
                No committees, no handoffs. I design, build, and ship your project directly.
              </Step>
            </li>
            <li>
              <Step number={3} title="You keep it running">
                Everything I build is yours: source code, docs, and a walkthrough so you are never
                dependent on me.
              </Step>
            </li>
          </ol>
        </div>

        <div>
          <p style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-wl-sub); margin: 0 0 24px 0;">
            ServiceCard - default + highlight variant
          </p>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 32px; padding-top: 16px;">
            <ServiceCard
              variant="default"
              benefit="Ship faster"
              title="Web apps that do the work"
              body="Intake forms, client portals, booking flows built to your workflow, not a template."
            >
              <svg
                slot="icon"
                aria-hidden="true"
                width="22"
                height="22"
                viewBox="0 0 22 22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                xmlns="http://www.w3.org/2000/svg"
                style="color: #ffffff;"
              >
                <rect x="3" y="3" width="16" height="16" rx="2" />
                <path d="M3 9h16M9 21V9" />
              </svg>
            </ServiceCard>

            <ServiceCard
              variant="highlight"
              kicker="ALL THE HELP, NONE OF THE HYPE"
              benefit="Automate the grind"
              title="AI workflows built for your business"
              body="From lead intake to reporting, I wire up AI where it actually saves you time."
            >
              <svg
                slot="icon"
                aria-hidden="true"
                width="22"
                height="22"
                viewBox="0 0 22 22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                xmlns="http://www.w3.org/2000/svg"
                style="color: #ffffff;"
              >
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
              </svg>
            </ServiceCard>
          </div>
        </div>

      </div>
    </section>

    <section style="background: #12333B; padding: 64px 48px;">
      <div style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 40px;">

        <h2 style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #8CB5B3; margin: 0; padding-bottom: 8px; border-bottom: 1px solid rgba(234,246,243,0.15);">
          On-dark variants - ink strip (#12333B literal, D-13 non-flippable)
        </h2>

        <div>
          <p style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #8CB5B3; margin: 0 0 16px 0;">
            CTA Button - ghost-on-dark (non-flippable D-10 literals)
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center;">
            <CTAButton href="/#book" variant="ghost-on-dark">Book a call</CTAButton>
            <CTAButton href="/#book" variant="ghost-on-dark">Need reliable overflow dev?</CTAButton>
          </div>
        </div>

        <div>
          <p style="font-family: var(--font-wl-body); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #8CB5B3; margin: 0 0 16px 0;">
            Eyebrow - on-dark (#5AA9A5 literal, non-flippable D-10)
          </p>
          <Eyebrow onDark>For agencies</Eyebrow>
        </div>

        <div style="border: 1px solid rgba(234,246,243,0.15); border-radius: 12px; padding: 20px 24px;">
          <p style="font-family: var(--font-wl-body); font-size: 12px; font-weight: 600; color: #C0D9D8; margin: 0 0 8px 0;">
            Items to eyeball at fidelity gate:
          </p>
          <ul style="font-family: var(--font-wl-body); font-size: 12px; color: #8CB5B3; margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 4px;">
            <li>Derived hovers: solid/small opacity-90, ghost rgba(255,255,255,0.6), ghost-on-dark rgba(255,255,255,0.08)</li>
            <li>LinkCard hover: text-wl-accent derived (no Figma hover spec)</li>
            <li>Step numeral: accent-soft #5AA9A5 on paper = 2.63:1 (DECORATIVE/aria-hidden) - Figma decision if change wanted</li>
            <li>ServiceCard body slot: empty div renders when no body prop - intentional</li>
          </ul>
        </div>

      </div>
    </section>

  </main>
</BaseLayout>
