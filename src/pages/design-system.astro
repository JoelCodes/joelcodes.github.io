---
/**
 * /design-system — v2 Design System Reference Page
 *
 * TDD note: This page is markup/composition. No meaningful unit-level test exists
 * for the rendering logic. Wave 3 Plan 24-03 Playwright + axe-core tests will
 * validate this page at the integration level (keyboard navigation, focus rings,
 * aria wiring, zero accessibility violations). Test intent documented here per
 * the TDD directive for Plan 24-04.
 */
import BaseLayout from '../layouts/v2/BaseLayout.astro';
import Button from '../components/v2/ui/Button.astro';
import Card from '../components/v2/ui/Card.astro';
import CardHeader from '../components/v2/ui/CardHeader.astro';
import CardBody from '../components/v2/ui/CardBody.astro';
import CardFooter from '../components/v2/ui/CardFooter.astro';
import Input from '../components/v2/ui/Input.astro';
import Badge from '../components/v2/ui/Badge.astro';
import { ArrowRight, Sparkles, Mail } from '@lucide/astro';

const colorTokens = [
  { name: 'primary',       var: '--color-primary'      },
  { name: 'primary-hover', var: '--color-primary-hover' },
  { name: 'surface',       var: '--color-surface'       },
  { name: 'surface-muted', var: '--color-surface-muted' },
  { name: 'text',          var: '--color-text'          },
  { name: 'text-muted',    var: '--color-text-muted'    },
  { name: 'border',        var: '--color-border'        },
  { name: 'accent',        var: '--color-accent'        },
];

const typographyTokens = [
  { name: 'display', utility: 'text-display', sample: 'Display — 3rem (48px)' },
  { name: 'h1',      utility: 'text-h1',      sample: 'Heading 1 — 2.25rem (36px)' },
  { name: 'h2',      utility: 'text-h2',      sample: 'Heading 2 — 1.875rem (30px)' },
  { name: 'h3',      utility: 'text-h3',      sample: 'Heading 3 — 1.5rem (24px)' },
  { name: 'h4',      utility: 'text-h4',      sample: 'Heading 4 — 1.25rem (20px)' },
  { name: 'body',    utility: 'text-body',    sample: 'Body — 1rem (16px)' },
  { name: 'small',   utility: 'text-small',   sample: 'Small — 0.875rem (14px)' },
  { name: 'caption', utility: 'text-caption', sample: 'Caption — 0.75rem (12px)' },
];
---

<BaseLayout
  title="Design System (v2) | Joel Shinness"
  description="Internal v2 design system reference. Live demos of Button, Card, Input, and Badge primitives built on the Crito-anchored token foundation."
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <div class="container mx-auto px-lg py-2xl max-w-5xl">

    <!-- Introduction -->
    <section id="introduction" class="mb-2xl">
      <h1 class="font-display text-display font-bold text-text mb-md">
        Design System (v2)
      </h1>
      <p class="font-text text-body text-text-muted mb-sm">
        Internal reference for Joel and AI coding agents. Live demos of all four v2 primitives
        built on the Crito-anchored token foundation (Plans 24-01 and 24-02).
        Zero v1 token references, zero is&#58;global, zero dark-mode utilities.
      </p>
      <p class="font-text text-small text-text-muted">
        Machine-readable token endpoint:
        <a href="/design-system.json" class="text-text underline hover:text-text-muted transition-colors ml-xs">
          /design-system.json
        </a>
      </p>
    </section>

    <!-- Tokens -->
    <section id="tokens" class="mb-2xl">
      <h2 class="font-display text-h2 font-bold text-text mb-md">Tokens</h2>

      <!-- Color swatches -->
      <h3 class="font-display text-h3 font-semibold text-text mb-sm">Colors</h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-md mb-xl">
        {colorTokens.map((token) => (
          <div class="flex flex-col gap-xs">
            <div
              class="h-12 rounded-md border border-border"
              style={`background-color: var(${token.var})`}
            />
            <span class="font-text text-caption text-text-muted">{token.name}</span>
            <span class="font-text text-caption text-text-muted">{token.var}</span>
          </div>
        ))}
      </div>

      <!-- Typography scale -->
      <h3 class="font-display text-h3 font-semibold text-text mb-sm">Typography</h3>
      <div class="flex flex-col gap-sm mb-xl border border-border rounded-lg p-md bg-surface">
        {typographyTokens.map((t) => (
          <div class="flex items-baseline gap-md border-b border-border pb-sm last:border-b-0 last:pb-0">
            <span class={`font-display font-semibold text-text leading-none ${t.utility}`}>
              Aa
            </span>
            <span class="font-text text-small text-text-muted">{t.sample}</span>
            <code class="font-text text-caption text-text-muted bg-surface-muted px-xs py-1 rounded-sm ml-auto">{t.utility}</code>
          </div>
        ))}
      </div>
    </section>

    <!-- Button -->
    <section id="button" class="mb-2xl">
      <h2 class="font-display text-h2 font-bold text-text mb-md">Button</h2>
      <p class="font-text text-small text-text-muted mb-lg">
        3 variants (primary, ghost, link) &times; 3 sizes (sm, md, lg). Polymorphic href&#8594;&lt;a&gt;/&lt;button&gt;. Lucide icon props. Accent focus ring.
      </p>

      <!-- Primary variant -->
      <h3 class="font-display text-h4 font-semibold text-text mb-sm">Primary</h3>
      <div class="flex flex-wrap items-center gap-md mb-lg">
        <Button variant="primary" size="sm">Primary sm</Button>
        <Button variant="primary" size="md">Primary md</Button>
        <Button variant="primary" size="lg">Primary lg</Button>
      </div>

      <!-- Ghost variant -->
      <h3 class="font-display text-h4 font-semibold text-text mb-sm">Ghost</h3>
      <div class="flex flex-wrap items-center gap-md mb-lg">
        <Button variant="ghost" size="sm">Ghost sm</Button>
        <Button variant="ghost" size="md">Ghost md</Button>
        <Button variant="ghost" size="lg">Ghost lg</Button>
      </div>

      <!-- Link variant -->
      <h3 class="font-display text-h4 font-semibold text-text mb-sm">Link</h3>
      <div class="flex flex-wrap items-center gap-md mb-lg">
        <Button variant="link" size="sm">Link sm</Button>
        <Button variant="link" size="md">Link md</Button>
        <Button variant="link" size="lg">Link lg</Button>
      </div>

      <!-- Icon and state demos -->
      <h3 class="font-display text-h4 font-semibold text-text mb-sm">Icons &amp; States</h3>
      <div class="flex flex-wrap items-center gap-md mb-lg">
        <Button variant="primary" iconLeft={Sparkles}>With iconLeft</Button>
        <Button variant="primary" iconRight={ArrowRight}>With iconRight</Button>
        <Button variant="ghost" href="/faq">Polymorphic &lt;a&gt;</Button>
        <Button variant="primary" disabled={true}>Disabled</Button>
      </div>
    </section>

    <!-- Card -->
    <section id="card" class="mb-2xl">
      <h2 class="font-display text-h2 font-bold text-text mb-md">Card</h2>
      <p class="font-text text-small text-text-muted mb-lg">
        Default, elevated (shadow-md), interactive (hover lift + focus ring), and composition with CardHeader+CardBody+CardFooter.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-md mb-lg">
        <!-- Default card -->
        <Card>
          <div class="p-md">
            <p class="font-display text-h4 font-semibold text-text mb-xs">Default Card</p>
            <p class="font-text text-small text-text-muted">bg-surface, border-border, rounded-lg</p>
          </div>
        </Card>

        <!-- Elevated card -->
        <Card elevated={true}>
          <div class="p-md">
            <p class="font-display text-h4 font-semibold text-text mb-xs">Elevated Card</p>
            <p class="font-text text-small text-text-muted">elevated=true adds shadow-md token</p>
          </div>
        </Card>

        <!-- Interactive card -->
        <Card interactive={true}>
          <div class="p-md">
            <p class="font-display text-h4 font-semibold text-text mb-xs">Interactive Card</p>
            <p class="font-text text-small text-text-muted">interactive=true: tabindex=0, hover lift, focus ring</p>
          </div>
        </Card>

        <!-- Composed card with CardHeader + CardBody + CardFooter -->
        <Card elevated={true}>
          <CardHeader>
            <p class="font-display text-h4 font-semibold text-text">Card Composition</p>
          </CardHeader>
          <CardBody>
            <p class="font-text text-small text-text-muted">
              CardHeader + CardBody + CardFooter slot wrappers with token padding.
            </p>
          </CardBody>
          <CardFooter>
            <Button variant="primary" size="sm">Action</Button>
          </CardFooter>
        </Card>
      </div>
    </section>

    <!-- Input -->
    <section id="input" class="mb-2xl">
      <h2 class="font-display text-h2 font-bold text-text mb-md">Input</h2>
      <p class="font-text text-small text-text-muted mb-lg">
        Polymorphic (input / textarea / select). Required label + id. error, helper, disabled, required props. aria-describedby error-priority wiring. Accent focus ring.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-md mb-lg">
        <!-- Default text input -->
        <Input
          label="Name"
          id="ds-name"
          name="name"
          placeholder="Jane Smith"
        />

        <!-- Error state -->
        <Input
          label="Email"
          id="ds-email"
          name="email"
          value="not-an-email"
          error="Please enter a valid email address"
        />

        <!-- Helper text -->
        <Input
          label="Phone"
          id="ds-phone"
          name="phone"
          placeholder="+1 (555) 000-0000"
          helper="Optional — we will not call without your permission"
        />

        <!-- Required field -->
        <Input
          label="Subject"
          id="ds-subject"
          name="subject"
          placeholder="How can I help?"
          required={true}
        />

        <!-- Disabled state -->
        <Input
          label="Submitted"
          id="ds-submitted"
          name="submitted"
          value="Locked"
          disabled={true}
        />

        <!-- Textarea (as="textarea") -->
        <Input
          as="textarea"
          label="Message"
          id="ds-message"
          name="message"
          placeholder="Tell me about your project..."
          rows={4}
        />
      </div>

      <!-- Select (as="select") -->
      <div class="max-w-sm mb-lg">
        <Input
          as="select"
          label="Budget"
          id="ds-budget"
          name="budget"
        >
          <option value="">Select a range</option>
          <option value="1k-5k">$1,000 – $5,000</option>
          <option value="5k-15k">$5,000 – $15,000</option>
          <option value="15k-plus">$15,000+</option>
        </Input>
      </div>
    </section>

    <!-- Badge -->
    <section id="badge" class="mb-2xl">
      <h2 class="font-display text-h2 font-bold text-text mb-md">Badge</h2>
      <p class="font-text text-small text-text-muted mb-lg">
        Non-interactive chip/tag &lt;span&gt;. 3 variants (accent, muted, outline). Optional iconLeft Lucide prop.
      </p>

      <div class="flex flex-wrap items-center gap-sm mb-lg">
        <Badge variant="accent">New</Badge>
        <Badge variant="muted">Beta</Badge>
        <Badge variant="outline">Draft</Badge>
        <Badge variant="accent" iconLeft={Mail}>Inbox</Badge>
        <Badge variant="muted" iconLeft={Sparkles}>AI-assisted</Badge>
        <Badge variant="outline" iconLeft={ArrowRight}>In progress</Badge>
      </div>
    </section>

  </div>
</BaseLayout>
