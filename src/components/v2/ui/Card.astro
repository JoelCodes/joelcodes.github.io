---
export interface Props {
  elevated?: boolean;
  interactive?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  elevated = false,
  interactive = false,
  class: className = '',
  ...rest
} = Astro.props;
---

<div
  tabindex={interactive ? 0 : undefined}
  class:list={[
    'bg-surface border border-border rounded-lg overflow-hidden',
    elevated && 'shadow-md',
    interactive && 'cursor-pointer transition-transform duration-200 hover:-translate-y-0.5',
    className,
  ]}
  {...rest}
>
  <slot />
</div>

<style>
  /* Focus ring — accent outline per D-18. Only rule that requires scoped CSS. */
  div:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
