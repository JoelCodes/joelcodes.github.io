---
import MobileNav from './MobileNav.astro';

const links = [
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/faq', label: 'FAQ' },
  { href: '/#contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/$/, '');

function isActive(href: string, current: string): boolean {
  if (href.startsWith('/#')) return false;
  return current === href || current.startsWith(href + '/');
}
---

<header class="sticky top-0 z-30 bg-surface border-b border-border">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between">
    <a
      href="/"
      class="font-display text-xl font-bold text-text hover:text-accent transition-colors"
    >
      Joel Shinness
    </a>

    <nav class="hidden md:flex items-center gap-6" aria-label="Primary">
      {links.map(link => (
        <a
          href={link.href}
          aria-current={isActive(link.href, path) ? 'page' : undefined}
          class:list={[
            'font-text font-medium text-text hover:text-accent transition-colors',
            { 'text-accent underline underline-offset-[6px]': isActive(link.href, path) },
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/#contact"
        class="inline-flex items-center px-5 py-2.5 rounded-md bg-accent text-text font-text font-semibold hover:opacity-90 transition-opacity"
      >
        Let's Talk
      </a>
    </nav>

    <MobileNav links={links} />
  </div>
</header>
