---
interface Props {
  class?: string;
  size?: number;
  /**
   * badge — wrap the wave strokes in a light circular badge.
   * Use on dark surfaces: dark-mode header and always-dark footer.
   * Spec: Figma nodes 42:77 (footer) and 117:104 (dark header).
   * Badge fill #EAF6F3 (--wl-footer-wordmark-color); wave strokes #12333B (ink).
   */
  badge?: boolean;
}

const { class: className = '', size = 32, badge = false } = Astro.props;

// Wave strokes occupy roughly 60% of the viewBox (104 units).
// Badge circle = full 30px box; waves centered inside.
---

{badge ? (
  <!-- Circle-badge presentation: light disc with ink wave strokes -->
  <!-- Used on dark surfaces (dark header, always-dark footer) -->
  <svg
    width={size}
    height={size}
    viewBox="0 0 104 104"
    fill="none"
    class={className}
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Circular badge fill (#EAF6F3) -->
    <circle cx="52" cy="52" r="52" fill="#EAF6F3" />
    <!-- Wave strokes in ink (#12333B) — same paths, color fixed for dark surfaces -->
    <path d="M14 36C30 24 46 44 62 34C74 27 84 38 90 32" stroke="#12333B" stroke-opacity="0.45" stroke-width="5" stroke-linecap="round"/>
    <path d="M10 54C28 40 48 64 68 52C80 44 90 56 96 50" stroke="#12333B" stroke-width="6" stroke-linecap="round"/>
    <path d="M14 72C30 62 48 80 64 70C76 63 86 72 90 68" stroke="#12333B" stroke-opacity="0.65" stroke-width="5" stroke-linecap="round"/>
  </svg>
) : (
  <!-- Bare-stroke presentation: waves in currentColor -->
  <!-- Used on light surfaces (light-mode header) -->
  <svg
    width={size}
    height={size}
    viewBox="0 0 104 104"
    fill="none"
    class={className}
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M14 36C30 24 46 44 62 34C74 27 84 38 90 32" stroke="currentColor" stroke-opacity="0.45" stroke-width="5" stroke-linecap="round"/>
    <path d="M10 54C28 40 48 64 68 52C80 44 90 56 96 50" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
    <path d="M14 72C30 62 48 80 64 70C76 63 86 72 90 68" stroke="currentColor" stroke-opacity="0.65" stroke-width="5" stroke-linecap="round"/>
  </svg>
)}
